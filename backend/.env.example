# ===========================================================================
# 彭城智学 SmartLearn Agent —— 后端环境变量模板
# 用法：复制为项目根 .env（或 backend/.env），填入真实值。
# ⚠️ 禁止把本文件中的占位值替换为真实密钥后提交到版本库。
# ===========================================================================

# ---- LLM / Embedding（OpenAI 兼容接口）-------------------------------------
# 统一走 OpenAI 兼容协议：/v1/chat/completions 与 /v1/embeddings
# 双配置组：对话与推理走 LLM_*（如 DeepSeek）；向量化走 EMBEDDING_*
# （如硅基流动 BAAI/bge-m3）。EMBEDDING_* 任一项为空时逐项回退对应
# LLM_* 值（单服务商部署只需配置 LLM_* 三项）。
# 对话配置组
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 向量化配置组（留空则逐项回退上方 LLM_* 值）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ---- 安全 -------------------------------------------------------------------
# 启动必填：必须替换为随机强密钥；保留占位值或留空会让服务拒绝启动。
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
# 用 start.bat / start.sh 启动时会自动生成并写回本文件。
JWT_SECRET=change-me-in-env
JWT_ALGORITHM=HS256
# Token 有效期（分钟），默认 7 天
JWT_EXPIRE_MINUTES=10080

# ---- 数据库 -----------------------------------------------------------------
# 默认使用项目根 data/smartlearn.db（SQLite），无需配置。
# 如需覆盖，请写绝对路径，例如：
# DATABASE_URL=sqlite:///D:/smartlearn/data/smartlearn.db
# DATABASE_URL=sqlite:///./data/smartlearn.db

# ---- 向量库 -----------------------------------------------------------------
# 默认使用项目根 data/chroma，无需配置。如需覆盖，请写绝对路径：
# CHROMA_DIR=./data/chroma

# ---- 应用 -------------------------------------------------------------------
APP_NAME=SmartLearn Agent
DEBUG=true
# 允许跨域的前端地址（JSON 数组格式）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# RAG 检索相似度阈值：低于该值的命中视为无据（默认 0.55，留空回退默认值）
RAG_MIN_SCORE=0.55